# Virtual environments
venv/
env/
.venv/
*.venv

# Python cache
__pycache__/
*.pyc
*.pyo

# Streamlit runtime secrets
# NOTE: .streamlit/config.toml is committed on purpose — it carries the
# app's theme and has to reach the deployment. Only secrets are ignored.
.streamlit/secrets.toml

# OS files
.DS_Store
Thumbs.db

# Jupyter checkpoints
.ipynb_checkpoints/

# The model files, landmark CSV and dataset are deliberately committed.
# Streamlit Community Cloud installs only what is in the repository, so
# removing them would leave the deployed app with nothing to load.
